<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="副卡短信转发 · 副端"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F3F5"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textSize="12sp"
            android:text="读取中…" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="① 授予权限" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="② 电池白名单" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动服务" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="停止服务" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAppDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开本应用系统设置页（自启动/省电策略在各家 ROM 里）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="过滤规则（一行一个，命中任一即转发；排除词命中则一律不转）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etInclude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="包含关键词，如：验证码"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etExclude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="排除关键词，如：退订"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/swDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无关键词、但含 4~8 位数字也转发" />

        <CheckBox
            android:id="@+id/cbNotifyEach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="每转发一条，本机也弹一条通知" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="转发通道"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbWebhook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自建 / 任意 webhook（POST JSON）" />

            <RadioButton
                android:id="@+id/rbBark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bark" />

            <RadioButton
                android:id="@+id/rbNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="只在本机留通知（不外发，自测用）" />

            <RadioButton
                android:id="@+id/rbSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="短信直发到主机号（受 ROM 逐条确认限制，ColorOS 上不可用）" />

            <RadioButton
                android:id="@+id/rbEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="邮箱通道（发到自己的邮箱，主端轮询收）" />
        </RadioGroup>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="通道地址，如 http://192.168.1.8:8787/ingest"
            android:inputType="textUri"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="共享口令（可选，走 X-Token / Bearer 头）"
            android:inputType="text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSmsDest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="短信直发目标：主机号码（选短信通道时必填）"
            android:inputType="phone"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etMailUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="邮箱通道：发件邮箱（如 123456@qq.com）"
            android:inputType="textEmailAddress"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etMailPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="邮箱通道：SMTP 授权码（QQ 邮箱设置里生成）"
            android:inputType="textPassword"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etMailTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="收件邮箱（留空=发给自己）"
            android:inputType="textEmailAddress"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存设置" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="自测（走与真实短信完全相同的链路）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTestBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnInject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="注入一条自测短信" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="记录（最近 30 条，含未命中的）"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="刷新状态 / 记录 / 日志" />

        <TextView
            android:id="@+id/tvRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F7F7F7"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textSize="11sp"
            android:text="（还没有记录）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="运行日志（最近 60 条）"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F7F7F7"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textSize="11sp"
            android:text="（暂无日志）" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空日志" />
    </LinearLayout>
</ScrollView>
